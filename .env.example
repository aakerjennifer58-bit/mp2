# Set these in Vercel > Project > Settings > Environment Variables. Never commit real values.
MPESA_ENV=live
CONSUMER_KEY=
CONSUMER_SECRET=
SHORTCODE=
INITIATOR_NAME=
SECURITY_CREDENTIAL=         # 344 chars, from: node credential.js <cert.cer> "<password>"
ADMIN_PASSWORD=              # login password for the page
MAX_AMOUNT=100
ALLOWED_PHONES=              # comma-separated 2547XXXXXXXX; empty = any
# CALLBACK_BASE=https://your-domain.com   # optional; defaults to the Vercel production URL
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_TOTP_SECRET=          # optional base32 secret for an authenticator app (2FA)
